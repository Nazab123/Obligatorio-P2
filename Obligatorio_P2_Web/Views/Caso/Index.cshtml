@using Obligatorio_P2
@model List<Caso>

@{
    ViewData["Title"] = "Todos los casos";
}

<h2>Todos los casos</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

@if (Model.Count == 0)
{
    <p>No hay casos registrados.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Descripción</th>
                <th>Sospechoso</th>
                <th>Detective</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>

        <tbody>
            @foreach (Caso caso in Model)
            {
                <tr>
                    <td>@caso.Id</td>
                    <td>@caso.Nombre</td>
                    <td>@caso.Descripcion</td>
                    <td>@caso.Sospechoso.Nombre</td>
                    <td>@caso.Detective.Nombre</td>
                    <td>
                        @if (caso.Cerrado)
                        {
                            <span>Cerrado</span>
                        }
                        else
                        {
                            <span>Abierto</span>
                        }
                    </td>
                    <td>
                        @Html.ActionLink(
                            "Ver detalles",
                            "Details",
                            new { id = caso.Id },
                            new { @class = "btn btn-primary" }
                        )
                    </td>
                </tr>
            }
        </tbody>
    </table>
}